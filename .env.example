# Copy to .env for local Docker runs, or set these in Render -> Environment.
# Never commit real values.

# Port the Java HttpServer listens on. Render sets PORT automatically —
# do not set it there.
PORT=8080

# Neon PostgreSQL (JDBC URL format). Neon shows a URL like
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Split it into the three variables below.
DB_URL=jdbc:postgresql://YOUR-NEON-HOST/neondb?sslmode=require&channel_binding=require
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password

# Time zone used for timestamps (JVM + JDBC session)
TZ=Asia/Thimphu
